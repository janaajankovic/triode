{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(docker compose *)",
      "Bash(docker build *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin feature/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(terraform fmt*)",
      "Bash(terraform validate*)",
      "Bash(terraform init*)",
      "Bash(terraform plan*)",
      "Bash(aws sts get-caller-identity*)",
      "Bash(aws * describe-*)",
      "Bash(aws * list-*)",
      "Bash(aws logs tail *)",
      "Bash(npm *)",
      "Bash(npx ng *)",
      "mcp__atlassian"
