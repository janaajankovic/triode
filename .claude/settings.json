    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(terraform destroy*)",
      "Bash(rm -rf *)",
      "Bash(aws iam *)",
      "Read(./.env)",
      "Read(./**/*.tfvars)"
    ]
  }
}
